# First Pit — iOS shell build template (`npm run ios:build`).
#
# Copy to .env.ios.local (gitignored). The iOS bundle is built in Vite mode
# `ios`, which loads .env.local first and then this file on top, so every key
# below must be set here or the local emulator value leaks through. The mode
# counts as production: src/lib/env.ts hard-fails with emulators on, and
# scripts/ios-bundle-check.mjs refuses to sync such a bundle into Xcode.
#
# The values are the production project's Firebase *web* app config — public
# by design. Fetch them with:
#   npx firebase apps:sdkconfig WEB --project production

VITE_APP_NAME=First Pit
VITE_APP_TAGLINE=FLL team management

VITE_FIREBASE_API_KEY=set-from-sdkconfig
VITE_FIREBASE_AUTH_DOMAIN=set-from-sdkconfig
VITE_FIREBASE_PROJECT_ID=set-from-sdkconfig
VITE_FIREBASE_STORAGE_BUCKET=set-from-sdkconfig
VITE_FIREBASE_MESSAGING_SENDER_ID=set-from-sdkconfig
VITE_FIREBASE_APP_ID=set-from-sdkconfig
VITE_FIREBASE_MEASUREMENT_ID=

VITE_USE_FIREBASE_EMULATORS=false

# The public website. Links that leave the app (invites, email continue URLs)
# use it, because the shell's own origin is capacitor://localhost. Must be an
# authorized domain in Firebase Auth.
VITE_PUBLIC_WEB_ORIGIN=https://www.first-pit.com
