rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveMember(teamId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/memberships/$(teamId + '_' + request.auth.uid))
        && firestore.get(/databases/(default)/documents/memberships/$(teamId + '_' + request.auth.uid)).data.teamId == teamId
        && firestore.get(/databases/(default)/documents/memberships/$(teamId + '_' + request.auth.uid)).data.userId == request.auth.uid
        && firestore.get(/databases/(default)/documents/memberships/$(teamId + '_' + request.auth.uid)).data.status == 'active';
    }

    function filesEnabled(teamId) {
      return firestore.exists(/databases/(default)/documents/teamPolicies/$(teamId))
        && firestore.get(/databases/(default)/documents/teamPolicies/$(teamId)).data.fileSharing == 'teamOnly';
    }

    function fileMetadataPath(fileId) {
      return /databases/(default)/documents/fileMetadata/$(fileId);
    }

    function matchingFileMetadata(teamId, fileId, fileName) {
      return firestore.exists(fileMetadataPath(fileId))
        && firestore.get(fileMetadataPath(fileId)).data.teamId == teamId
        && firestore.get(fileMetadataPath(fileId)).data.storagePath == 'teams/' + teamId + '/files/' + fileId + '/' + fileName;
    }

    match /teams/{teamId}/files/{fileId}/{fileName} {
      allow read: if isActiveMember(teamId)
        && filesEnabled(teamId)
        && matchingFileMetadata(teamId, fileId, fileName)
        && firestore.get(fileMetadataPath(fileId)).data.status == 'ready'
        // 'notConfigured' used to be accepted here, but createFileMetadata wrote
        // that value once and nothing ever changed it, so the scan gate enforced
        // nothing. completeFileUpload now promotes 'pending' -> 'clean', which
        // makes this a real check.
        && firestore.get(fileMetadataPath(fileId)).data.scanStatus == 'clean';
      allow create: if isActiveMember(teamId)
        && filesEnabled(teamId)
        && matchingFileMetadata(teamId, fileId, fileName)
        && firestore.get(fileMetadataPath(fileId)).data.status == 'pending'
        && firestore.get(fileMetadataPath(fileId)).data.uploadedBy == request.auth.uid
        && request.resource.size > 0
        && request.resource.size <= 10485760
        && request.resource.size == firestore.get(fileMetadataPath(fileId)).data.sizeBytes
        && request.resource.contentType == firestore.get(fileMetadataPath(fileId)).data.contentType
        && request.resource.contentType in ['application/pdf', 'text/plain', 'text/csv', 'application/zip', 'image/png', 'image/jpeg', 'image/webp'];
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
