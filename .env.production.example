# First Pit — production/preview environment template (Vercel).
#
# Set these in the Vercel project (Settings → Environment Variables) or with
#   vercel env add <NAME> production
# Do NOT create a real .env.production file in this repo — it is gitignored on
# purpose, and src/lib/env.ts hard-fails a production build with emulators on.

VITE_APP_NAME=First Pit
VITE_APP_TAGLINE=FLL team management

# Firebase web app config for the production project.
VITE_FIREBASE_API_KEY=set-in-vercel
VITE_FIREBASE_AUTH_DOMAIN=set-in-vercel
VITE_FIREBASE_PROJECT_ID=set-in-vercel
VITE_FIREBASE_STORAGE_BUCKET=set-in-vercel
VITE_FIREBASE_MESSAGING_SENDER_ID=set-in-vercel
VITE_FIREBASE_APP_ID=set-in-vercel
VITE_FIREBASE_MEASUREMENT_ID=

# Emulators must stay off outside local development.
VITE_USE_FIREBASE_EMULATORS=false

# --- Google Calendar integration (server side, Cloud Functions) -------------
# These are Functions secrets, NOT Vite vars: they must never reach the client
# bundle. Set them with:
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
#   firebase functions:secrets:set GOOGLE_TOKEN_ENCRYPTION_KEY
# and the non-secret values as function environment variables.
#
# GOOGLE_OAUTH_CLIENT_ID       OAuth 2.0 Web client ID from Google Cloud console
# GOOGLE_OAUTH_CLIENT_SECRET   matching client secret
# GOOGLE_OAUTH_REDIRECT_URI    https://<region>-<project>.cloudfunctions.net/api/google/oauth/callback
#                              (must be listed verbatim as an Authorized redirect URI)
# GOOGLE_TOKEN_ENCRYPTION_KEY  >=16 chars; AES-256-GCM key material for refresh tokens at rest
# APP_BASE_URL                 https://<your-vercel-domain>  (where the callback returns the user)
