# First Pit — production/preview environment template (Vercel).
#
# Set these in the Vercel project (Settings → Environment Variables) or with
#   vercel env add <NAME> production
# Do NOT create a real .env.production file in this repo — it is gitignored on
# purpose, and src/lib/env.ts hard-fails a production build with emulators on.

VITE_APP_NAME=First Pit
VITE_APP_TAGLINE=FLL team management

# Firebase web app config for the production project.
VITE_FIREBASE_API_KEY=set-in-vercel
VITE_FIREBASE_AUTH_DOMAIN=set-in-vercel
VITE_FIREBASE_PROJECT_ID=set-in-vercel
VITE_FIREBASE_STORAGE_BUCKET=set-in-vercel
VITE_FIREBASE_MESSAGING_SENDER_ID=set-in-vercel
VITE_FIREBASE_APP_ID=set-in-vercel
VITE_FIREBASE_MEASUREMENT_ID=

# Emulators must stay off outside local development.
VITE_USE_FIREBASE_EMULATORS=false
