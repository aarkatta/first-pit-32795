rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }

    function membershipPath(teamId, userId) {
      return /databases/$(database)/documents/memberships/$(teamId + '_' + userId);
    }

    function isActiveMember(teamId) {
      return signedIn()
        && exists(membershipPath(teamId, request.auth.uid))
        && get(membershipPath(teamId, request.auth.uid)).data.teamId == teamId
        && get(membershipPath(teamId, request.auth.uid)).data.userId == request.auth.uid
        && get(membershipPath(teamId, request.auth.uid)).data.status == 'active';
    }

    function isTeamAdmin(teamId) {
      return teamId is string && (isPlatformAdmin()
        || (isActiveMember(teamId)
          && get(membershipPath(teamId, request.auth.uid)).data.role in ['coach', 'teamLeader']));
    }

    function validMembershipId(membershipId, data) {
      return data.keys().hasAll(['teamId', 'userId', 'status', 'role'])
        && data.teamId is string
        && data.userId is string
        && membershipId == data.teamId + '_' + data.userId
        && data.status in ['active', 'pending', 'suspended', 'removed']
        && data.role in ['student', 'parent', 'mentor', 'coach', 'teamLeader'];
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isPlatformAdmin());
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL'])
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'email', 'uid', 'updatedAt', 'createdAt']);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow get, list: if isActiveMember(teamId) || isPlatformAdmin();
      allow update: if isTeamAdmin(teamId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'normalizedName', 'updatedAt']);
      allow create, delete: if false;
    }

    match /memberships/{membershipId} {
      allow get: if signedIn()
        && validMembershipId(membershipId, resource.data)
        && (resource.data.userId == request.auth.uid || isTeamAdmin(resource.data.teamId));
      allow list: if signedIn()
        && (resource.data.userId == request.auth.uid
          || (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)));
      allow create, update, delete: if false;
    }

    match /invitations/{invitationId} {
      allow get, list: if signedIn()
        && (isPlatformAdmin()
          || (request.auth.token.email_verified == true
            && resource.data.email == request.auth.token.email
            && (!('targetUserId' in resource.data) || resource.data.targetUserId == request.auth.uid))
          || (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)));
      allow create, update, delete: if false;
    }

    match /joinRequests/{requestId} {
      allow get, list: if signedIn()
        && (isPlatformAdmin()
          || resource.data.userId == request.auth.uid
          || (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)));
      allow create, update, delete: if false;
    }

    match /teamPolicies/{teamId} {
      allow get, list: if isActiveMember(teamId) || isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /notificationPreferences/{userId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll(['userId', 'emailNotifications', 'pushNotifications', 'safetyNotifications'])
        && request.resource.data.keys().hasOnly(['userId', 'emailNotifications', 'pushNotifications', 'safetyNotifications', 'updatedAt'])
        && request.resource.data.emailNotifications is bool
        && request.resource.data.pushNotifications is bool
        && request.resource.data.safetyNotifications == true;
      allow delete: if false;
    }

    match /privacySettings/{userId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll(['userId', 'profileVisibility', 'searchable', 'allowParentVisibility', 'privateConversations'])
        && request.resource.data.keys().hasOnly(['userId', 'profileVisibility', 'searchable', 'allowParentVisibility', 'privateConversations', 'isMinor', 'updatedAt'])
        && request.resource.data.profileVisibility == 'teamOnly'
        && request.resource.data.searchable == false
        && request.resource.data.allowParentVisibility == false
        && request.resource.data.privateConversations == false;
      allow delete: if false;
    }

    match /userSettings/{userId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll(['userId', 'theme', 'highContrast', 'reducedMotion', 'fontScale'])
        && request.resource.data.keys().hasOnly(['userId', 'theme', 'highContrast', 'reducedMotion', 'fontScale', 'updatedAt'])
        && request.resource.data.theme in ['light', 'dark', 'system']
        && request.resource.data.highContrast is bool
        && request.resource.data.reducedMotion is bool
        && request.resource.data.fontScale in ['default', 'large'];
      allow delete: if false;
    }

    match /accountDeletionRequests/{userId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow get, list: if signedIn()
        && (isPlatformAdmin()
          || resource.data.reporterUserId == request.auth.uid
          || (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)));
      allow create, update, delete: if false;
    }

    match /moderationCases/{caseId} {
      allow get, list: if signedIn()
        && (isPlatformAdmin() || (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)));
      allow create, update, delete: if false;
    }

    match /auditEvents/{eventId} {
      allow get, list: if isPlatformAdmin()
        || (signedIn() && resource.data.teamId is string && isTeamAdmin(resource.data.teamId));
      allow create, update, delete: if false;
    }

    function hasTeamFields(data) {
      return data.keys().hasAll(['teamId']) && data.teamId is string;
    }

    function filesEnabled(teamId) {
      return exists(/databases/$(database)/documents/teamPolicies/$(teamId))
        && get(/databases/$(database)/documents/teamPolicies/$(teamId)).data.fileSharing == 'teamOnly';
    }

    match /tasks/{taskId} {
      allow get, list: if isPlatformAdmin() || (signedIn() && hasTeamFields(resource.data) && isActiveMember(resource.data.teamId));
      allow create, update, delete: if false;
    }

    match /projects/{projectId} {
      allow get, list: if isPlatformAdmin() || (signedIn() && hasTeamFields(resource.data) && isActiveMember(resource.data.teamId));
      allow create, update, delete: if false;
    }

    match /projectTemplates/{templateId} {
      allow get, list: if isPlatformAdmin() || (signedIn() && hasTeamFields(resource.data) && isActiveMember(resource.data.teamId));
      allow create, update, delete: if false;
    }

    match /goals/{goalId} {
      allow get, list: if isPlatformAdmin() || (signedIn() && hasTeamFields(resource.data) && isActiveMember(resource.data.teamId));
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.recipientUserId == request.auth.uid && resource.data.teamId is string && isActiveMember(resource.data.teamId);
      // Read receipts go through the markNotificationRead callable, so the
      // client keeps no write path here.
      allow create, update, delete: if false;
    }

    function canReadQuestion(data) {
      return (signedIn()
        && data.visibility == 'community'
        && data.teamId == null
        && data.moderationStatus == 'published')
        || (data.visibility == 'team'
          && data.teamId is string
          && isActiveMember(data.teamId)
          && data.moderationStatus != 'removed');
    }

    // Mirrors KNOWLEDGE_EDITOR_ROLES in functions/src/phase2.ts: these roles
    // publish team videos, so they must be able to read the drafts.
    function isKnowledgeEditor(teamId) {
      return isPlatformAdmin()
        || (isActiveMember(teamId)
          && get(membershipPath(teamId, request.auth.uid)).data.role in ['coach', 'teamLeader', 'mentor', 'student']);
    }

    function canReadVideo(data) {
      return (signedIn()
        && data.visibility == 'community'
        && data.teamId == null
        && data.publicationStatus == 'published')
        || (data.visibility == 'team'
          && data.teamId is string
          && isActiveMember(data.teamId)
          && (data.publicationStatus == 'published'
            || data.createdBy == request.auth.uid
            || isKnowledgeEditor(data.teamId)));
    }

    match /questions/{questionId} {
      allow get, list: if canReadQuestion(resource.data);
      allow create, update, delete: if false;
    }

    match /answers/{answerId} {
      allow get, list: if canReadQuestion(resource.data);
      allow create, update, delete: if false;
    }

    match /questionComments/{commentId} {
      allow get, list: if canReadQuestion(resource.data);
      allow create, update, delete: if false;
    }

    match /questionVotes/{voteId} {
      allow get, list: if signedIn() && resource.data.voterUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /savedQuestions/{saveId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /videos/{videoId} {
      allow get, list: if canReadVideo(resource.data);
      allow create, update, delete: if false;
    }

    match /videoFavorites/{favoriteId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /videoWatchHistory/{historyId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /polls/{pollId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    match /pollVotes/{voteId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    match /pollHistory/{historyId} {
      allow get, list: if isPlatformAdmin()
        || (signedIn() && resource.data.teamId is string && isTeamAdmin(resource.data.teamId));
      allow create, update, delete: if false;
    }

    match /taskHistory/{historyId} {
      allow get, list: if isPlatformAdmin() || (signedIn() && hasTeamFields(resource.data) && isActiveMember(resource.data.teamId));
      allow create, update, delete: if false;
    }

    match /taskComments/{commentId} {
      allow get, list: if isPlatformAdmin() || (signedIn() && hasTeamFields(resource.data) && isActiveMember(resource.data.teamId));
      allow create, update, delete: if false;
    }

    match /fileMetadata/{fileId} {
      allow get, list: if isPlatformAdmin() || (signedIn()
        && hasTeamFields(resource.data)
        && isActiveMember(resource.data.teamId)
        && filesEnabled(resource.data.teamId)
        && resource.data.status != 'deleted'
        && (resource.data.status == 'ready'
          || resource.data.uploadedBy == request.auth.uid
          || isTeamAdmin(resource.data.teamId)));
      allow create, update, delete: if false;
    }

    match /folders/{folderId} {
      allow get, list: if isPlatformAdmin() || (signedIn() && hasTeamFields(resource.data) && isActiveMember(resource.data.teamId));
      allow create, update, delete: if false;
    }

    match /phase3Operations/{operationId} {
      allow read, write: if false;
    }

    match /kanbanOperations/{operationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
